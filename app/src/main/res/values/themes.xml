<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- الثيم الفاتح (افتراضي) -->
    <style name="AppTheme" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@color/primary_dark</item>
    </style>

    <!-- الثيم الليلي الخفيف (Dim - رمادي دافئ، ليس أسود) -->
    <style name="AppTheme.Dim" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">#1565C0</item>
        <item name="colorPrimaryDark">#0D47A1</item>
        <item name="colorAccent">#42A5F5</item>
        <item name="android:windowBackground">#1E2330</item>
        <item name="android:statusBarColor">#0D1929</item>
    </style>

    <!-- الثيم الليلي الغامق (Dark) -->
    <style name="AppTheme.Dark" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">#1976D2</item>
        <item name="colorPrimaryDark">#0D47A1</item>
        <item name="colorAccent">#64B5F6</item>
        <item name="android:windowBackground">#121212</item>
        <item name="android:statusBarColor">#000000</item>
    </style>

</resources>
